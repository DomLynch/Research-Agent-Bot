[Unit]
Description=Run Research Agent v3 daily paper submit

[Timer]
# Every 4h, offset +2h from the revise lane (00/4:15) so the two submit-side
# lanes interleave instead of colliding on the same minute.
OnCalendar=*-*-* 02/4:15:00
Persistent=false
Unit=research-agent-paper-daily-submit.service

[Install]
WantedBy=timers.target
