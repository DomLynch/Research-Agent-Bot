[Unit]
Description=Run Research Agent v3 daily paper submit

[Timer]
# Every 8h, offset +2h after the fresh lane (00/8) so a freshly synthesized
# paper is ready by the time submit fires. Revise lane stays at 00/4:15.
OnCalendar=*-*-* 02/8:15:00
Persistent=false
Unit=research-agent-paper-daily-submit.service

[Install]
WantedBy=timers.target
