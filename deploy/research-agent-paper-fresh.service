[Unit]
Description=Research Agent v3 FRESH lane — always attempt a new paper (never blocked by revise backlog)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/research-agent-bot
EnvironmentFile=/etc/research-agent-bot/research-agent-bot.env
ExecStart=/opt/research-agent-bot/.venv/bin/python scripts/daily_research_paper_cycle.py --mode fresh --run-synthesis --submit --max-attempts 0 --cycle-budget-sec 10800
Environment=PYTHONUNBUFFERED=1
Environment=RESEARCH_AGENT_CORPUS_REPAIR_LIMIT=1
Environment=RESEARCH_AGENT_SEED_TOPIC_TIMEOUT_SECONDS=300
Restart=on-failure
RestartSec=60
TimeoutStartSec=14400
