[Unit]
Description=Research Agent v3 REVISE lane — process one pending Researka revise (never blocks the fresh lane)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/research-agent-bot
EnvironmentFile=/etc/research-agent-bot/research-agent-bot.env
ExecStart=/opt/research-agent-bot/.venv/bin/python scripts/daily_research_paper_cycle.py --mode revise --run-synthesis --submit --max-revise-attempts 3 --cycle-budget-sec 3600
Environment=PYTHONUNBUFFERED=1
Environment=RESEARKA_DOI_PREFLIGHT_ENABLED=1
Environment=RESEARKA_ARTICLE_TYPE_V3=research_synthesis
Restart=on-failure
RestartPreventExitStatus=2
RestartSec=60
TimeoutStartSec=4200
