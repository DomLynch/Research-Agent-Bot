[Unit]
Description=Research Agent v3 REVISE lane — process one pending Researka revise (never blocks the fresh lane)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=21600
StartLimitBurst=2

[Service]
Type=oneshot
SuccessExitStatus=3
WorkingDirectory=/opt/research-agent-bot
EnvironmentFile=/etc/research-agent-bot/research-agent-bot.env
ExecStart=/usr/bin/flock --shared --nonblock /run/research-agent-paper-prepare.lock /opt/research-agent-bot/.venv/bin/python scripts/daily_research_paper_cycle.py --mode revise --run-synthesis --submit --max-revise-attempts 3 --cycle-budget-sec 3600
Environment=PYTHONUNBUFFERED=1
Environment=RESEARKA_DOI_PREFLIGHT_ENABLED=1
Restart=on-failure
RestartSec=60
RestartPreventExitStatus=3
TimeoutStartSec=4200
