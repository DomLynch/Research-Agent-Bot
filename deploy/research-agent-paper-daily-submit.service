[Unit]
Description=Research Agent v3 daily paper submit
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
SuccessExitStatus=3
WorkingDirectory=/opt/research-agent-bot
EnvironmentFile=/etc/research-agent-bot/research-agent-bot.env
ExecStart=/usr/bin/flock --conflict-exit-code 75 --shared --wait 900 /run/research-agent-paper-prepare.lock /opt/research-agent-bot/.venv/bin/python scripts/daily_research_paper_submit.py --submit
Environment=PYTHONUNBUFFERED=1
Environment=RESEARKA_DOI_PREFLIGHT_ENABLED=1
TimeoutStartSec=1800
