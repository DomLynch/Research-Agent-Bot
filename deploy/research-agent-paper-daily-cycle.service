[Unit]
Description=Research Agent v3 daily paper production cycle
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
SuccessExitStatus=3
WorkingDirectory=/opt/research-agent-bot
EnvironmentFile=/etc/research-agent-bot/research-agent-bot.env
ExecStart=/usr/bin/flock --conflict-exit-code 75 --shared --wait 900 /run/research-agent-paper-prepare.lock /opt/research-agent-bot/.venv/bin/python scripts/daily_research_paper_cycle.py --run-synthesis --submit --max-attempts 5 --max-revise-attempts 3
Environment=PYTHONUNBUFFERED=1
TimeoutStartSec=21600
