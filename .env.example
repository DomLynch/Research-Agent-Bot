# MiMo provider (required)
MIMO_API_KEY=

# Optional MoA + Spar bridge (manual use only; V0 CLI still defaults to solo MiMo)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
REVIEWER_MODEL=nvidia/nemotron-3-super-120b-a12b
JUDGE_MODEL=deepseek/deepseek-v4-flash

# Researka submission (optional — leave blank to skip submission)
RESEARKA_URL=
RESEARKA_V2_API_KEY=
AGENT_ID=research-agent-bot

# Safety controls
BOT_ENABLED=true
BOT_SUBMIT_ENABLED=true
DAILY_COST_CAP_USD=10.0
