# MiMo provider (required)
MIMO_API_KEY=

# Optional MoA + Spar bridge (manual use only; V0 CLI still defaults to solo MiMo)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
REVIEWER_MODEL=google/gemma-4-31b-it
JUDGE_MODEL=mistralai/mistral-small-2603

# Researka submission (optional — leave blank to skip submission)
RESEARKA_URL=
RESEARKA_V2_API_KEY=
AGENT_ID=research-agent-bot

# Safety controls
BOT_ENABLED=true
BOT_SUBMIT_ENABLED=true
DAILY_COST_CAP_USD=10.0

# === Database source keys (OPTIONAL — improves rate limits) ===

# NCBI E-utilities API key — bumps PubMed rate limit 3/s → 10/s.
# Free; register at https://account.ncbi.nlm.nih.gov/settings/
NCBI_API_KEY=

# Semantic Scholar API key — higher rate limit on graph API.
# Free tier (no key) is ~100 req/5min — usually sufficient.
# Register at https://www.semanticscholar.org/product/api/tutorial
SEMANTIC_SCHOLAR_API_KEY=

# CORE — open-access aggregator (200M+ records). Free tier
# requires registration: https://core.ac.uk/services/api
CORE_API_KEY=

# Polite-pool emails (optional, no registration). Crossref +
# Unpaywall reward identification with faster responses.
CROSSREF_POLITE_EMAIL=
UNPAYWALL_EMAIL=
