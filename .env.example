# MiMo provider (required)
MIMO_API_KEY=

# MoA + Spar bridge (default for extractor and drafter)
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M2.7-highspeed
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-reasoner

# Researka submission (optional — leave blank to skip submission)
RESEARKA_URL=
RESEARKA_V2_API_KEY=
AGENT_ID=research-agent-bot

# Safety controls
BOT_ENABLED=true
BOT_SUBMIT_ENABLED=true
DAILY_COST_CAP_USD=10.0
