# MiMo provider (required)
MIMO_API_KEY=
MIMO_MODEL=mimo-v2.5-pro

# MoA+Spar bridge providers (default model path)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
REVIEWER_MODEL=mistralai/mistral-small-2603
JUDGE_MODEL=google/gemma-4-31b-it

# Researka submission (optional — leave blank to skip submission)
RESEARKA_URL=
RESEARKA_V2_API_KEY=
AGENT_ID=research-agent-bot

# Safety controls
BOT_ENABLED=true
BOT_SUBMIT_ENABLED=true
DAILY_COST_CAP_USD=10.0
