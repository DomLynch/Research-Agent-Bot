.venv/
__pycache__/
.pytest_cache/
*.pyc
# Slice 24 (2026-05-15): run-launch shell logs (pipeline output captured
# at invocation time). Per-run, regenerated; never review-worthy.
logs/
# Day 10.17 Phase 3 — Europe PMC fetch cache. JATS XML blobs cached
# locally so re-runs don't re-hit the API. Per-PMCID files; safe to
# wipe at any time. Pre-fix audit flag: a contributor running the
# fetcher from repo root would have committed XML blobs.
.cache/
# Claude Code session state — local IDE artifacts, never commit.
.claude/
# Ignore generated run artifacts. Keep proof runs outside git; regenerate or
# recover from the external archive when needed.
runs/*
tests_legacy/golden/fixture_runs/
tests_legacy/golden/fixture_runs_debug/
*.egg-info/
.env*
!.env.example

scripts/karpathy-loop/snapshots/
scripts/karpathy-loop/diffs/

.DS_Store
# macOS / iCloud auto-versioning leaves "<name> 2.<ext>" duplicates next to
# files when they're rewritten. They've snuck into commits before — block them.
* 2.*
* [0-9].*

scripts/karpathy-loop/snapshots/
scripts/karpathy-loop/diffs/

docs/weekly/

# Quality-reference PDFs (Day 10.17 Phase 1 / Path B-prime). They are
# the prose-quality benchmark the system targets, NOT inputs the bot
# synthesizes from. Each PDF is sourced via DOI/PMID listed in
# docs/quality-reference/metformin/README.md. Mirror copy lives on
# the VPS under the same path; binary blobs don't go in git.
docs/quality-reference/metformin/pdfs/

# v0.6.0 diagnostic paper run — the load-bearing artifact for Phase 6-lite
# (proves the v0.6.0 evidence layer can feed prose; mortality/lifespan
# polarity bug fixed; treatment-timing protocol-tagged; deterministic
# Methods + manifest with real LLM call log).
!runs/diagnostic-paper-2026-05-02T15-00-45Z/
# Phase 6.1 v0.6.0 synthesis paper — first AAA-grade run from production
